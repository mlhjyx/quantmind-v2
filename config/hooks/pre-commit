#!/bin/sh
# Phase 4.2 sustained Layer 4 Topic 1 A:
#   pre-commit 验 staged .md 数字 vs canonical 真值 (5 metric: factor count / Tier 0 / LL / D 决议 / 测试 baseline)
#   minimal scope first pass: warning-only (print canonical + remind cite source + timestamp), 真**0 block** sustained
#   (Layer 2 candidate: 升级 strict block on mismatch detect)
# 启用: git config core.hooksPath config/hooks
# 紧急绕过: git commit --no-verify (需 commit message 声明绕过原因)
set -e
cd "$(git rev-parse --show-toplevel)"

# === S6 LLM import block (V3 §5.5 + ADR-020, sustained user 决议 a-vi) ===
# scope: backend/ + scripts/ Python files (排除 tests/), staged-only mode
# allowlist marker (`# llm-import-allow:<reason>`) 见 docs/LLM_IMPORT_POLICY.md §9
if [ -x scripts/check_llm_imports.sh ]; then
    if ! sh scripts/check_llm_imports.sh --staged; then
        echo ""
        echo "[pre-commit] S6 LLM import block — commit 被阻断."
        echo "[pre-commit] 详情见上方 BLOCK message + docs/LLM_IMPORT_POLICY.md"
        exit 1
    fi
fi

# Check staged .md files
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
if [ -z "$STAGED_MD" ]; then
    # No .md staged, skip
    exit 0
fi

# Select Python (consistent with pre-push)
if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
else
    PY="python"
fi

# Run canonical verify (Python heuristic, sustained pre-push pattern)
"$PY" -c "
import sys, pathlib

ROOT = pathlib.Path('.').resolve()
canonical = {}
warnings = []

# 1. factor count (DB SQL)
try:
    import psycopg2
    conn = psycopg2.connect(host='localhost', port=5432, dbname='quantmind_v2', user='xin', password='quantmind', connect_timeout=3)
    cur = conn.cursor()
    cur.execute('SELECT count(DISTINCT factor_name) FROM factor_ic_history;')
    canonical['factor_count'] = cur.fetchone()[0]
    cur.close(); conn.close()
except Exception as e:
    warnings.append(f'factor_count DB query skipped: {type(e).__name__}: {e}')
    canonical['factor_count'] = 'N/A (DB unreachable)'

# 2. Tier 0 数 (grep TIER0_REGISTRY.md)
try:
    p = ROOT / 'docs/audit/TIER0_REGISTRY.md'
    if p.exists():
        text = p.read_text(encoding='utf-8')
        # Heuristic: count unique 'T0-N' IDs in markdown (table or section headers)
        import re
        ids = set(re.findall(r'T0-\d+', text))
        canonical['tier0_unique_ids'] = len(ids)
    else:
        canonical['tier0_unique_ids'] = 'N/A (file missing)'
except Exception as e:
    warnings.append(f'tier0 grep skipped: {type(e).__name__}: {e}')
    canonical['tier0_unique_ids'] = 'N/A'

# 3. LL 数 (grep LESSONS_LEARNED.md)
try:
    p = ROOT / 'LESSONS_LEARNED.md'
    if p.exists():
        text = p.read_text(encoding='utf-8')
        import re
        # Heuristic: count unique LL-NNN IDs (3-digit)
        ids = set(re.findall(r'LL-\d{2,3}', text))
        canonical['ll_unique_ids'] = len(ids)
    else:
        canonical['ll_unique_ids'] = 'N/A (file missing)'
except Exception as e:
    warnings.append(f'll grep skipped: {type(e).__name__}: {e}')
    canonical['ll_unique_ids'] = 'N/A'

# 4. D 决议 数 (grep DECISION_LOG.md)
try:
    p = ROOT / 'docs/DECISION_LOG.md'
    if p.exists():
        text = p.read_text(encoding='utf-8')
        import re
        # Count '### D-N' or '### D-{prefix}' headers
        headers = re.findall(r'^### D-\S+', text, re.MULTILINE)
        canonical['d_headers'] = len(headers)
    else:
        canonical['d_headers'] = 'N/A (file missing)'
except Exception as e:
    warnings.append(f'd grep skipped: {type(e).__name__}: {e}')
    canonical['d_headers'] = 'N/A'

# 5. 测试 baseline (defer to pre-push hook smoke run, 这里仅 cite sprint state baseline)
#    iter 187 W4-A LL-188 hook drift fix → iter 231 baseline refresh → iter 232
#    fail baseline reduction: iter 80 (6714/2) → iter 231 (6869/2) → iter 232
#    (6869/1) — identified + FIXED "1 unknown sweep" via Windows GBK encoding
#    bug in test_llm_import_block_governance subprocess.run(text=True) default
#    encoding (now explicit encoding='utf-8' + errors='replace').
#    SSOT: CLAUDE.md §当前进度 §其他状态. Re-sync when CLAUDE.md baseline updates.
canonical['test_baseline'] = '6869 collected / 1 fail (CLAUDE.md iter 232 fresh verify 2026-05-27 SSOT, 铁律 40 baseline)'

# 6. LL-188 step 0 sediment-drift check (Session 58 round-6 NEW):
#    Scan staged .md files for red-line claims (EXECUTION_MODE / LIVE_TRADING_DISABLED)
#    and compare against backend/.env real values. Warn on mismatch (sustained warning-only style).
#    反 LL-188 pattern (Session 57+1 6 rounds 全程 false 'paper' claim while .env=live for 3+ weeks).
try:
    import re
    env_file = ROOT / 'backend/.env'
    if env_file.exists():
        env_text = env_file.read_text(encoding='utf-8')
        m_mode = re.search(r'^EXECUTION_MODE=(\S+)', env_text, re.MULTILINE)
        m_disabled = re.search(r'^LIVE_TRADING_DISABLED=(\S+)', env_text, re.MULTILINE)
        env_actual_mode = m_mode.group(1).strip() if m_mode else 'paper'  # default
        env_actual_disabled = m_disabled.group(1).strip().lower() if m_disabled else 'true'
        canonical['env_actual'] = f'EXECUTION_MODE={env_actual_mode} / LIVE_TRADING_DISABLED={env_actual_disabled}'

        # Scan staged .md for claim mismatch.
        # iter 223 fix: skip historical sediment docs (LESSONS_LEARNED.md +
        # docs/audit/STATUS_REPORT_*.md + docs/audit/L4R_DIGEST_LOG.md) — these
        # legitimately DOCUMENT past LL-188 drift cases as historical record,
        # not making current claims. Hook lacks context-awareness for
        # quoted/code-block vs current-claim, so file-level skip is canonical.
        # Sustained: doc-sediment files preserve drift history per LL-209/LL-212.
        SEDIMENT_FILES = {
            'LESSONS_LEARNED.md',  # canonical LL sediment
            'docs/audit/L4R_DIGEST_LOG.md',  # digest log (past digest summaries)
        }
        def _is_sediment_file(path: str) -> bool:
            if path in SEDIMENT_FILES:
                return True
            # docs/audit/STATUS_REPORT_*.md historical reports document past drift
            if path.startswith('docs/audit/STATUS_REPORT_') and path.endswith('.md'):
                return True
            return False
        import subprocess
        staged = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM']).decode().splitlines()
        staged_md = [f for f in staged if f.endswith('.md') and not _is_sediment_file(f)]
        ll_188_warnings = []
        for f in staged_md:
            try:
                # Use cached blob (not working tree — may have un-staged edits)
                content = subprocess.check_output(['git', 'show', f':{f}']).decode(errors='replace')
            except Exception:
                continue
            # Detect EXECUTION_MODE claims
            for claim_match in re.finditer(r'EXECUTION_MODE=(\w+)', content):
                claimed = claim_match.group(1).lower()
                if claimed in ('paper', 'live') and claimed != env_actual_mode.lower():
                    ll_188_warnings.append(f'{f}: claims EXECUTION_MODE={claimed} but .env actual={env_actual_mode}')
            # Detect LIVE_TRADING_DISABLED claims
            for claim_match in re.finditer(r'LIVE_TRADING_DISABLED=(\w+)', content):
                claimed = claim_match.group(1).lower()
                if claimed in ('true', 'false') and claimed != env_actual_disabled:
                    ll_188_warnings.append(f'{f}: claims LIVE_TRADING_DISABLED={claimed} but .env actual={env_actual_disabled}')

        if ll_188_warnings:
            canonical['LL_188_sediment_drift'] = f'⚠️  {len(ll_188_warnings)} mismatch found in staged .md'
            for w in ll_188_warnings[:10]:  # cap at 10 to avoid spam
                warnings.append(f'  LL-188 drift: {w}')
        else:
            canonical['LL_188_sediment_drift'] = '✅ no drift detected'
    else:
        canonical['env_actual'] = 'N/A (backend/.env missing)'
except Exception as e:
    warnings.append(f'LL-188 sediment-drift check skipped: {type(e).__name__}: {e}')
    canonical['LL_188_sediment_drift'] = 'N/A (check skipped)'

# Print canonical
print('[pre-commit] 6 metric canonical (sustained Phase 4.2 Layer 4 Topic 1 A + LL-188 Session 58 round-6):')
for k, v in canonical.items():
    print(f'  {k}: {v}')

# Warnings (skipped checks)
if warnings:
    print('[pre-commit] 警告 (跳过的 check):')
    for w in warnings:
        print(f'  - {w}')

# Reminder (warning-only first pass, 0 block)
print('[pre-commit] 提醒: staged .md 中**任一上述数字** 必 cite source + timestamp (sustained handoff_template.md §3 SOP).')
print('[pre-commit] Phase 4.2 minimal scope: warning-only, 真**0 block** sustained. (Layer 2 候选: 升级 strict block on mismatch detect)')
print('[pre-commit] 紧急绕过 (违反 SOP, 需 commit message 声明原因): git commit --no-verify')
" 2>&1

# Print staged .md count
STAGED_COUNT=$(echo "$STAGED_MD" | wc -l | tr -d ' ')
echo "[pre-commit] Staged .md files: $STAGED_COUNT"
echo "[pre-commit] 放行 (warning-only minimal scope sustained)."
exit 0
